<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Microsoft Testing Platform replaces the VSTest runner; opt-in also needs
         "test": { "runner": ... } in global.json. See docs/contributing.md §9. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <!-- mtp-v2 variant of xunit.v3; MTP v2 is what GitHubActionsTestLogger 3.x needs. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <ProjectReference Include="..\..\src\TeamsNotificationBot\TeamsNotificationBot.csproj" />
  </ItemGroup>
</Project>
